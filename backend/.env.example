NODE_ENV=development
PORT=4000

# MongoDB debe correr como replica set (requisito de Mongoose/MongoDB para transacciones ACID).
# Local: mongod --replSet rs0  |  Atlas: ya viene como replica set.
MONGO_URI=mongodb://127.0.0.1:27017/klassy_f?replicaSet=rs0

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=8h

# Usados solo por scripts/seed.js para crear el primer ADMIN
SEED_ADMIN_NOMBRE=Super
SEED_ADMIN_APELLIDO=Admin
SEED_ADMIN_TIPO_DOCUMENTO=CC
SEED_ADMIN_NUMERO_DOCUMENTO=0000000001
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=12345678
