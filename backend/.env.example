NODE_ENV=development
PORT=4000

# Este archivo es para correr en local (npm run dev). En el VPS las variables salen del .env
# de la raiz y de docker-compose.yml (ver DOCKER.md).
#
# MongoDB debe correr como replica set (requisito de Mongoose/MongoDB para transacciones ACID).
# Si falta MONGO_URI y NODE_ENV no es production, se usa el valor de abajo.
# Local: mongod --replSet rs0  |  Atlas: ya viene como replica set.
MONGO_URI=mongodb://127.0.0.1:27017/klassy?replicaSet=rs0
# Si en local usas el Mongo de Docker (docker compose up -d mongo), usa esta en su lugar:
# MONGO_URI=mongodb://127.0.0.1:27017/klassy?directConnection=true

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=8h

# Asistente flotante (opcional): con clave entiende lenguaje libre; sin ella el frontend usa su busqueda por palabras clave.
# ANTHROPIC_API_KEY=
# ASISTENTE_MODELO=claude-haiku-5-5

# M26 (Secretaría y Certificados): Secreto HMAC para la huella digital y QR de los certificados.
# En desarrollo puedes dejar un valor de prueba o generar uno con `openssl rand -hex 32`. En producción es obligatorio.
CERT_HMAC_SECRET=change-this-cert-hmac-secret-in-production-32bytes
# Dirección del Frontend donde el público y los códigos QR validan los certificados (en local: http://localhost:5173)
PUBLIC_URL=http://localhost:5173

# Correo a las familias por SMTP: citaciones (M24), inasistencias sin excusa (M13) y boletín publicado (M17). Sin SMTP_HOST y CORREO_REMITENTE
# todo se crea igual (portal y campanita), pero no se envía ningún correo. PUBLIC_URL (arriba) arma los enlaces de los correos.
# Qué avisos salen (inasistencias y boletines) se enciende o apaga en Configuración institucional → «Correos a las familias».
# Para probar en local sin enviar nada real puedes usar Mailpit/MailHog en el puerto 1025.
#
# Ejemplo con Brevo (brevo.com → SMTP y API → pestaña «SMTP», NO la de «API keys»):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=<el «Login» que Brevo muestra en esa pestaña, p. ej. abc123@smtp-brevo.com>
#   SMTP_PASS=<la clave que creas con «Generate SMTP key»; se ve una sola vez>
#   CORREO_REMITENTE="Colegio Ejemplo <no-responder@colegio.edu.co>"   # el remitente debe estar verificado en Brevo
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# CORREO_REMITENTE="Colegio Ejemplo <no-responder@colegio.edu.co>"

# Usados solo por scripts/seed.js para crear el primer ADMIN
SEED_ADMIN_NOMBRE=Super
SEED_ADMIN_APELLIDO=Admin
SEED_ADMIN_TIPO_DOCUMENTO=CC
SEED_ADMIN_NUMERO_DOCUMENTO=0000000001
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=12345678
