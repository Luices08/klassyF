# Variables para docker compose (VPS). Copiar a .env en la raiz del repo y cambiar los valores.
# MONGO_URI NO va aqui: docker-compose.yml la fija al contenedor `mongo`.

# Nombre de la base de datos dentro del contenedor de Mongo. La aplicacion (backend) y los scripts
# (herramientas) usan esta misma base. Para que la aplicacion muestre el colegio de la simulacion,
# cambialo a klassy_sim y reinicia el backend; para volver a la base de trabajo, klassy.
MONGO_DB=klassy

# Puerto publico del sitio (nginx). Con un proxy/HTTPS delante, por ejemplo 8080.
PUERTO_WEB=80
# Puerto de Mongo solo en 127.0.0.1 del servidor (para conectarse por tunel SSH).
PUERTO_MONGO=27017

# Obligatorio y distinto del de ejemplo: genera uno con `openssl rand -hex 32`.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# M26 (certificados) y M19 (cierres de promocion): secreto de la huella (HMAC). Obligatorio en produccion: sin el no se
# expiden ni se verifican certificados ni cierres de promocion. Genera uno con `openssl rand -hex 32`, guardalo aparte de
# la base de datos y NO lo cambies despues: cambiarlo invalida la verificacion de todo lo ya expedido.
CERT_HMAC_SECRET=fdfvdfvdfbdbdfbgfbdgbgbdbg
# Direccion publica del sitio (la que va dentro del QR), ej. https://colegio.edu.co. Vacia = se toma del host de la peticion.
PUBLIC_URL=

# Asistente flotante (opcional): con clave entiende lenguaje libre; sin ella usa la busqueda por palabras clave.
ANTHROPIC_API_KEY=
ASISTENTE_MODELO=claude-haiku-5-5

# M24 (citaciones a acudientes): correo saliente por SMTP (el del colegio, o un servicio como Brevo, SendGrid o Amazon SES).
# Con SMTP_HOST, CORREO_REMITENTE y PUBLIC_URL definidos, el servidor envia en segundo plano las citaciones con su boton de
# confirmacion. Sin ellos las citaciones se crean igual, pero el correo no sale y la pantalla lo avisa.
SMTP_HOST=
SMTP_PORT=587
# true para el puerto 465 (TLS directo); false para 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Quien aparece como remitente, ej. Colegio Ejemplo <no-responder@colegio.edu.co>
CORREO_REMITENTE=loscorazones.temafusion@gmail.com

# Primer ADMIN (solo lo usa `docker compose run --rm herramientas npm run seed`).
SEED_ADMIN_NOMBRE=Admin
SEED_ADMIN_APELLIDO=Klassy
SEED_ADMIN_TIPO_DOCUMENTO=CC
SEED_ADMIN_NUMERO_DOCUMENTO=0000000000
SEED_ADMIN_EMAIL=admin@klassy.edu.co
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Simulacion multi-año (opcional: `docker compose run --rm herramientas npm run sim -- --sin-respaldo`) ---
# Llena una base APARTE con un colegio ficticio y su historia (2024, 2025 y 2026 hasta hoy). Nunca escribe en la base de
# trabajo: el nombre de la base debe contener "sim" o la simulacion se niega a correr.
# Dentro de Docker el host de Mongo es `mongo` (no 127.0.0.1).
SIM_MONGO_URI=mongodb://mongo:27017/klassy_sim?replicaSet=rs0
# Carpeta de los archivos que genera (PDF de planes, entregas, soportes). La aplicacion los busca en /app/uploads.
SIM_UPLOADS_DIR=/app/uploads
# Respaldo por fase (necesita mongodump, que la imagen no trae: por eso se corre con --sin-respaldo).
SIM_RESPALDOS_DIR=/app/respaldos-sim
# Contraseñas de las cuentas que crea: ADMIN (documento 1000000001) y todos los demas (su numero de documento).
SIM_ADMIN_PASSWORD=KlassySim2024*
SIM_USUARIOS_PASSWORD=Klassy2024*

# --- HTTPS (opcional) ---
# Dominio del colegio, con el DNS (registro A) apuntando al VPS. Si se define, se usa
# docker-compose.https.yml (Caddy + certificado automatico). En ese modo PUERTO_WEB queda solo en 127.0.0.1 (ej. 8080).
# Dejar vacio para servir por HTTP en PUERTO_WEB.
DOMINIO=
