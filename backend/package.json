{
  "name": "klassy-nucleo-institucional",
  "version": "1.0.0",
  "description": "Klassy - Nucleo Institucional, RBAC y Matriculas con control de cupos (Prompt 1)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seed.ts",
    "seed:subjects": "tsx scripts/seedSubjects.ts",
    "migrate:superadmin-to-admin": "tsx scripts/migrateSuperadminToAdmin.ts",
    "migrate:m05-anio-lectivo": "tsx scripts/migrateM05AnioLectivo.ts",
    "migrate:folio-al-matricular": "tsx scripts/migrateFolioAlMatricular.ts",
    "migrate:estado-por-defecto": "tsx scripts/migrateEstadoPorDefecto.ts",
    "reset-admin-password": "tsx scripts/resetAdminPassword.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "oxlint src scripts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/pdfkit": "^0.17.6",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
