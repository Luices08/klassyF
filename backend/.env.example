NODE_ENV=development
PORT=4000

# Este archivo es para correr en local (npm run dev). En el VPS las variables salen del .env
# de la raiz y de docker-compose.yml (ver DOCKER.md).
#
# MongoDB debe correr como replica set (requisito de Mongoose/MongoDB para transacciones ACID).
# Si falta MONGO_URI y NODE_ENV no es production, se usa el valor de abajo.
# Local: mongod --replSet rs0  |  Atlas: ya viene como replica set.
MONGO_URI=mongodb://127.0.0.1:27017/klassy?replicaSet=rs0
# Si en local usas el Mongo de Docker (docker compose up -d mongo), usa esta en su lugar:
# MONGO_URI=mongodb://127.0.0.1:27017/klassy?directConnection=true

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=8h

# M26: en desarrollo, si falta, se deriva de JWT_SECRET. En produccion es obligatorio (ver .env.produccion.example).
# CERT_HMAC_SECRET=
# PUBLIC_URL=http://localhost:5173

# Usados solo por scripts/seed.js para crear el primer ADMIN
SEED_ADMIN_NOMBRE=Super
SEED_ADMIN_APELLIDO=Admin
SEED_ADMIN_TIPO_DOCUMENTO=CC
SEED_ADMIN_NUMERO_DOCUMENTO=0000000001
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=12345678
