NODE_ENV=development
PORT=4000

# MongoDB debe correr como replica set (requisito de Mongoose/MongoDB para transacciones ACID).
# Local: mongod --replSet rs0  |  Atlas: ya viene como replica set.
MONGO_URI=mongodb://127.0.0.1:27017/klassy?replicaSet=rs0

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=8h

# Usados solo por scripts/seed.js para crear el primer SUPERADMIN
SEED_SUPERADMIN_NOMBRE=Super
SEED_SUPERADMIN_APELLIDO=Admin
SEED_SUPERADMIN_TIPO_DOCUMENTO=CC
SEED_SUPERADMIN_NUMERO_DOCUMENTO=0000000000
SEED_SUPERADMIN_EMAIL=superadmin@klassy.edu.co
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
